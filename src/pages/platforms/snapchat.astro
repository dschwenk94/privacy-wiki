---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import SettingCard from '../../components/SettingCard.astro';
import WarningCallout from '../../components/WarningCallout.astro';
import CrossLinkChip from '../../components/CrossLinkChip.astro';
import FactCard from '../../components/FactCard.astro';
import platformData from '../../data/platforms/snapchat.json';
---

<PlatformLayout
  title="Snapchat"
  description="Snapchat's ephemerality is a feature, not a privacy guarantee. The platform collects precise location from Snap Map, behavioral signals from Stories and Spotlight, and off-Snap activity via its ad network."
  subtitle=""
  category="Social Media Platform"
  lastVerified="March 23, 2026"
  settingsCount={platformData.settings.length}
  severity="high"
  severityText="Snap Map collects and displays precise real-time location by default for users who enable Ghost Mode for the first time — but defaults on for many existing accounts. Off-Snap activity tracking via Snap Pixel. Ad personalization using detailed behavioral and interest data. Messages disappear visually but Snap retains metadata. My AI (Snapchat's chatbot) conversations are used to train AI models."
  owner="Snap Inc."
  ownerHQ="Santa Monica, CA"
  headquarters="Santa Monica, CA"
  monthlyUsers="~800M MAU"
  relatedPractices={[
    { label: 'Location Data', href: '/practices/location-data' },
    { label: 'Ad Personalization & Targeting', href: '/practices/ad-personalization' },
    { label: 'Off-Platform Activity Tracking', href: '/practices/off-platform-tracking' },
    { label: 'AI Training Data Usage', href: '/practices/ai-training' },
  ]}
>

  <!-- WHAT THEY COLLECT -->
  <div slot="what-they-collect">
    <div class="fact-grid">
      <FactCard
        label="Precise real-time location via Snap Map"
        text="When Snap Map is enabled, Snapchat collects and may display your real-time precise location to your friends. Location is also collected in the background when the app is open, regardless of whether you are actively using Snap Map."
        severity="critical"
      />
      <FactCard
        label="Messages disappear visually, not from servers"
        text="Snaps and messages are deleted from Snap's servers after they are opened or expire. However, metadata — who you message, when, how often — is retained. Content shared to Memories and Stories has different retention than direct messages."
        severity="high"
      />
      <FactCard
        label="My AI conversations train Snap's AI"
        text="Conversations with My AI (Snapchat's built-in chatbot) are used to train and improve Snap's AI models. The chatbot is pinned to the top of your Chat feed by default and cannot be unpinned without a Snapchat+ subscription."
        severity="high"
      />
      <FactCard
        label="Off-Snap tracking via Snap Pixel"
        text="Businesses install the Snap Pixel on their websites to run Snapchat ads. When you visit those sites, your activity is reported back to Snap. This happens whether the app is open or not."
        severity="high"
      />
    </div>

    <div class="collect-detail">
      <p>Snapchat collects extensive data from every session. Device identifiers, IP address, operating system, carrier, and hardware information are collected at login. Your interaction patterns — which Stories you watch and for how long, which Spotlight videos you engage with, which Lenses you use, and how you navigate the app — are logged as behavioral signals.</p>

      <p>Location data is a significant part of Snapchat's collection. When Snap Map is enabled, precise GPS coordinates are collected and updated continuously while the app is active. Snap states it also uses location to personalize content, show local Stories, and serve geo-targeted ads. Location is collected via GPS, Wi-Fi network positions, and IP address inference. The Snap Map setting controls what Snap shows other users, not whether Snap itself collects your location.</p>

      <p>Content posted to Stories, Spotlight, and Snap Map is treated differently from direct Snaps. Stories you post publicly are available to Snap's systems for content moderation, safety analysis, and advertising purposes. Spotlight videos submitted for monetization review are retained by Snap. Memories are stored encrypted on Snap's servers.</p>

      <p>Snap's advertising business is built on behavioral targeting. Through the Snap Pixel and Snap's SDK installed in third-party apps, Snap collects off-platform behavioral data to supplement your in-app profile. Snapchat's Audience Match product allows advertisers to upload customer email lists to match against Snap user accounts for targeting.</p>
    </div>
  </div>

  <!-- SETTINGS THAT MATTER -->
  <div slot="settings">
    {(() => {
      let lastSeverity = null;
      return platformData.settings.map((s) => {
        const showLabel = s.severity !== "critical" && s.severity !== lastSeverity;
        lastSeverity = s.severity;
        return (
          <>
            {showLabel && <h3 class="severity-group-label">{s.severity.charAt(0).toUpperCase() + s.severity.slice(1)}</h3>}
            <SettingCard
              name={s.name}
              severity={s.severity}
              defaultState={s.defaultState}
              platform={s.platform}
              path={s.path}
              webUrl={s.webUrl ?? undefined}
              webPath={s.webPath ?? undefined}
              description={s.description}
              whatItDoesnt={s.whatItDoesnt}
            />
          </>
        );
      });
    })()}
  </div>

  <!-- WHO GETS YOUR DATA -->
  <div slot="who-gets-data">
    <dl class="data-recipients">
      <div class="recipient">
        <dt>Snap Advertisers (via Snap Ads Platform)</dt>
        <dd>Brands running campaigns on Snapchat receive audience targeting capabilities based on your behavioral profile, interest categories, location data, and Audience Match results. Advertisers receive aggregate performance data and audience insights, not individual user records. However, the targeting precision means the profile Snap holds is used to match you to campaigns with significant accuracy.</dd>
      </div>

      <div class="recipient">
        <dt>The Snap Pixel Ecosystem</dt>
        <dd>Third-party websites and apps that have installed the Snap Pixel or Snap's SDK. Every time you visit a property with Snap's code installed, your visit is reported back to Snap. Retailers, e-commerce sites, and apps use this to measure ad effectiveness and build retargeting audiences. This operates whether you are logged into Snapchat or not.</dd>
      </div>

      <div class="recipient">
        <dt>OpenAI (My AI)</dt>
        <dd>My AI is powered by OpenAI's GPT models. Conversations you have with My AI are processed via OpenAI's API. Snap's privacy policy governs data use on Snap's side; OpenAI's privacy policy applies to how OpenAI processes API inputs. API data sent to OpenAI by business customers like Snap is not used by OpenAI to train models by default under enterprise API terms.</dd>
      </div>

      <div class="recipient">
        <dt>Third-Party Measurement Partners</dt>
        <dd>Snap works with mobile measurement partners including AppsFlyer, Branch, and Adjust to verify ad attribution. When you see a Snapchat ad and later take an action in an app or on a website, that conversion event travels through measurement partners back to the advertiser.</dd>
      </div>
    </dl>
  </div>

  <!-- WHAT THEY KNOW -->
  <div slot="what-they-know">
    <p>Snapchat's data profile reflects where you physically go, who your close contacts are, what your face looks like (from Lens usage and selfie camera interactions), and your behavioral patterns across the day. Snap Map data provides a location history that reveals home address, workplace, frequented businesses, and travel patterns for users who have had location enabled. Unlike platforms where location is inferred from IP, Snap Map collects precise GPS coordinates when the app is active.</p>

    <p>The ephemeral messaging model has shaped how users communicate on Snapchat. Many users share things in Snaps they would not post on Instagram precisely because they expect the content to disappear. The content does disappear from the conversation view. What remains is metadata: who you contacted, how frequently, at what hours, and what type of content was exchanged. For close relationships, this metadata is often more revealing than the content itself.</p>

    <p>Snap's ad targeting categories are more granular than most users expect. The Lifestyle and Interests categories in Ad Preferences reveal what Snap has inferred. Categories can include health conditions (inferred from behavior, not stated), financial situation indicators, relationship status, and purchasing intent signals drawn from Snap Map visits to retail locations and off-platform Pixel data.</p>

    <WarningCallout title="Ghost Mode does not stop Snap from tracking your location">
      <p>Ghost Mode is often described as a privacy feature. It is a social visibility feature. It controls what your friends see on the Snap Map, not what Snap collects. Snap's privacy policy states that location data is used for advertising personalization, local content, and product features regardless of Ghost Mode status. If you want to limit Snap's access to your location, you need to revoke Snapchat's location permission entirely in your device's Settings app. On iOS: Settings &rarr; Privacy & Security &rarr; Location Services &rarr; Snapchat &rarr; Never.</p>
    </WarningCallout>
  </div>

  <!-- RELATED PRACTICES -->
  <CrossLinkChip slot="related-practices" href="/practices/location-data" label="Location Data" type="practice" />
  <CrossLinkChip slot="related-practices" href="/practices/ad-personalization" label="Ad Personalization & Targeting" type="practice" />
  <CrossLinkChip slot="related-practices" href="/practices/off-platform-tracking" label="Off-Platform Activity Tracking" type="practice" />
  <CrossLinkChip slot="related-practices" href="/practices/ai-training" label="AI Training Data Usage" type="practice" />
  <CrossLinkChip slot="related-practices" href="/rights/coppa" label="COPPA (teen user base)" type="practice" />

  <!-- RELATED PLATFORMS -->
  <CrossLinkChip slot="related-platforms" href="/platforms/tiktok" label="TikTok" type="platform" />
  <CrossLinkChip slot="related-platforms" href="/platforms/meta" label="Meta / Instagram" type="platform" />
  <CrossLinkChip slot="related-platforms" href="/platforms/reddit" label="Reddit" type="platform" />

</PlatformLayout>

<style>
  .fact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .collect-detail {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
  }

  p {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  p:last-child {
    margin-bottom: 0;
  }

  .severity-group-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 1.75rem 0 0.75rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--color-border);
  }

  .severity-group-label:first-child {
    margin-top: 0;
  }

  .data-recipients {
    margin: 0;
  }

  .recipient {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .recipient:first-child {
    padding-top: 0;
  }

  .recipient:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .recipient dt {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.375rem;
  }

  .recipient dd {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }
</style>
