---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const platforms: Array<{
  name: string;
  href: string;
  category: string;
  severity: 'critical' | 'high' | 'medium';
  description: string;
  group?: string;
}> = [
  {
    name: 'TikTok',
    href: '/platforms/tiktok',
    category: 'Social Media Platform',
    severity: 'critical',
    description: 'Off-platform tracking via TikTok Pixel, GPS collection added in January 2026, no AI training opt-out for US users, and default-on ad targeting across platforms.',
  },
  {
    name: 'X / Twitter',
    href: '/platforms/x',
    category: 'Social Media Platform',
    severity: 'critical',
    description: 'Default-on Grok AI training added in 2024 without notification, data sharing with unspecified business partners, cross-device and location-based ad targeting.',
  },
  {
    name: 'Meta / Instagram',
    href: '/platforms/meta',
    category: 'Social Media Platform',
    severity: 'critical',
    description: 'The Meta Pixel tracks you across millions of third-party websites. Off-Facebook Activity, Audience Network ads, AI training on posts and photos with no US opt-out.',
  },
  {
    name: 'Google',
    href: '/platforms/google',
    category: 'Search, Advertising, and Cloud Platform',
    severity: 'critical',
    description: 'Google Analytics and the Google Ads network are present on roughly 90% of top websites. Cross-product combination of Search, YouTube, Maps, Gmail, Chrome, and Android data.',
  },
  {
    name: 'Amazon',
    href: '/platforms/amazon',
    category: 'E-Commerce & Smart Home Platform',
    severity: 'critical',
    description: 'Purchase history reveals income, health, and life stage. Alexa devices record voice inside homes. Ring cameras have law enforcement sharing relationships. Amazon Sidewalk uses customer hardware as a mesh network.',
  },
  {
    name: 'YouTube',
    href: '/platforms/youtube',
    category: 'Video Platform',
    severity: 'high',
    description: 'A Google product. Watch history, search queries, and granular engagement data (pause points, rewinds, skip decisions) feed the same Google advertising profile used across Search, Gmail, and the Display Network.',
  },
  {
    name: 'Reddit',
    href: '/platforms/reddit',
    category: 'Social Media Platform',
    severity: 'high',
    description: 'Sold post history to Google for AI training via a $60M annual data licensing deal. Ad targeting uses subreddit memberships, voting behavior, and off-Reddit activity. Deleted posts are retained on servers.',
  },
  {
    name: 'Snapchat',
    href: '/platforms/snapchat',
    category: 'Social Media Platform',
    severity: 'high',
    description: 'Ghost Mode does not stop Snap from tracking your location. Off-Snap activity tracking via Snap Pixel. My AI conversations are retained and used for AI training. Ephemeral messages leave metadata.',
  },
];

const smartTVs: Array<{
  name: string;
  href: string;
  category: string;
  severity: 'critical' | 'high' | 'medium';
  description: string;
}> = [
  {
    name: 'VIZIO',
    href: '/platforms/vizio',
    category: 'Smart TV Platform',
    severity: 'critical',
    description: 'ACR (Automatic Content Recognition) is on by default and runs on every input source. VIZIO paid the FTC $2.2M in 2017 for selling viewership data without disclosure. Now owned by Walmart.',
  },
  {
    name: 'Roku',
    href: '/platforms/roku',
    category: 'Smart TV Platform / Streaming Platform',
    severity: 'critical',
    description: 'Roku collects at the OS level across all apps on the device. Its entire revenue model is advertising and data licensing. ACR, app-level usage tracking, and cross-device identity are all on by default.',
  },
  {
    name: 'Samsung TV',
    href: '/platforms/samsung-tv',
    category: 'Smart TV Platform',
    severity: 'critical',
    description: 'Largest global smart TV market share. ACR runs via Viewing Information Services on Tizen OS, below any streaming app. Samsung Ads is the advertising platform built on that viewership data. Samba TV may run a second ACR layer simultaneously. Samsung settled with the Texas AG in February 2026 over consent practices.',
  },
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Platforms' },
];
---

<BaseLayout
  title="Platforms — Privacy Wiki"
  description="Privacy guides for TikTok, Meta, Instagram, X, Google, and other consumer platforms. What they collect and how to turn it off."
>
  <div class="page-container">
    <header class="page-header">
      <Breadcrumb crumbs={breadcrumbs} />
      <h1 class="page-title">Platforms</h1>
      <p class="page-subtitle">
        One page per platform. What they collect, which settings are worth
        changing, and exactly how to change them. Settings are verified against
        live interfaces, not documentation.
      </p>
    </header>

    <main>
      {platforms.length > 0 ? (
        <ul class="platform-list">
          {platforms.map((p) => (
            <li class="platform-item">
              <a href={p.href} class="platform-link">
                <div class="platform-header">
                  <span class="platform-name">{p.name}</span>
                  <span class={`severity-badge severity--${p.severity}`}>
                    {p.severity.toUpperCase()}
                  </span>
                </div>
                <div class="platform-meta">
                  <span class="platform-category">{p.category}</span>
                </div>
                <p class="platform-desc">{p.description}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-state">
          <div class="empty-header">
            <span class="empty-label">In progress</span>
          </div>
          <p class="empty-text">
            Platform pages are being built in order of search demand and
            severity. First up: TikTok, X, and Meta/Instagram.
          </p>
          <ul class="upcoming-list">
            <li>TikTok — off-platform tracking, ad targeting</li>
            <li>X / Twitter — Grok AI training opt-out</li>
            <li>Meta / Instagram — Off-Facebook Activity, Meta Pixel</li>
            <li>Google — Web &amp; App Activity, ad personalization</li>
          </ul>
        </div>
      )}

      <div class="group-section">
        <h2 class="group-heading">Smart TVs</h2>
        <ul class="platform-list">
          {smartTVs.map((p) => (
            <li class="platform-item">
              <a href={p.href} class="platform-link">
                <div class="platform-header">
                  <span class="platform-name">{p.name}</span>
                  <span class={`severity-badge severity--${p.severity}`}>
                    {p.severity.toUpperCase()}
                  </span>
                </div>
                <div class="platform-meta">
                  <span class="platform-category">{p.category}</span>
                </div>
                <p class="platform-desc">{p.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </main>

    <footer class="page-footer">
      <p class="footer-note">
        All settings verified by hand against live platform interfaces.
        Platform UIs change — if something's wrong,
        <a href="mailto:feedback@privacywiki.io">let us know</a>.
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2.5rem;
    padding-top: 1.5rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 600;
    margin: 0.75rem 0 0.625rem;
    color: var(--color-text-primary);
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 580px;
    line-height: 1.7;
    margin: 0;
  }

  .platform-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .platform-item {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: border-color 0.15s ease;
  }

  .platform-item:hover {
    border-color: #3a3a3a;
  }

  .platform-link {
    display: block;
    padding: 1rem 1.25rem;
    text-decoration: none;
  }

  .platform-link:hover {
    text-decoration: none;
  }

  .platform-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.375rem;
  }

  .platform-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .severity-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    border-radius: 2px;
    padding: 0.15em 0.5em;
    border: 1px solid;
  }

  .severity--critical {
    color: var(--color-critical);
    border-color: var(--color-critical);
  }

  .severity--high {
    color: var(--color-high);
    border-color: var(--color-high);
  }

  .severity--medium {
    color: var(--color-medium);
    border-color: var(--color-medium);
  }

  .platform-meta {
    margin-bottom: 0.375rem;
  }

  .platform-category {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .platform-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .empty-state {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 1.5rem 1.75rem;
  }

  .empty-header {
    margin-bottom: 0.75rem;
  }

  .empty-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 0.15em 0.5em;
  }

  .empty-text {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .upcoming-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .upcoming-list li {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    padding-left: 1rem;
    position: relative;
  }

  .upcoming-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  .group-section {
    margin-top: 2.5rem;
  }

  .group-heading {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--color-border);
  }

  .page-footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .footer-note a {
    color: var(--color-text-secondary);
  }
</style>
