---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import SettingCard from '../../components/SettingCard.astro';
import WarningCallout from '../../components/WarningCallout.astro';
import CrossLinkChip from '../../components/CrossLinkChip.astro';
import FactCard from '../../components/FactCard.astro';
import platformData from '../../data/platforms/meta.json';
---

<PlatformLayout
  title="Meta / Instagram"
  description="Meta has tracking code on millions of websites. Visiting any of them feeds your ad profile. Here are the settings that matter and what they actually do."
  subtitle=""
  category="Social Media Platform"
  lastVerified="March 23, 2026"
  settingsCount={platformData.settings.length}
  severity="critical"
  severityText="The most mature and comprehensive consumer data infrastructure that exists. Off-Facebook Activity tracking spans millions of third-party websites. Cross-platform data merging between Facebook and Instagram via Accounts Center. AI training on posts and photos with no US opt-out. The Audience Network serves targeted ads on thousands of unrelated apps using your Meta profile."
  owner="Meta Platforms"
  ownerHQ="Menlo Park, CA"
  headquarters="Menlo Park, CA"
  monthlyUsers="~3B MAU (Instagram)"
  relatedPractices={[
    { label: 'Off-Platform Activity Tracking', href: '/practices/off-platform-tracking' },
    { label: 'AI Training Data Usage', href: '/practices/ai-training' },
    { label: 'Ad Personalization & Targeting', href: '/practices/ad-personalization' },
    { label: 'Third-Party Data Sharing', href: '/practices/third-party-sharing' },
  ]}
>

  <!-- WHAT THEY COLLECT -->
  <div slot="what-they-collect">
    <div class="fact-grid">
      <FactCard
        label="Tracks you on millions of websites"
        text="The Meta Pixel is installed on millions of third-party websites. Every visit to a site with the Pixel fires an event back to Meta, whether or not you are logged in or have an account."
        severity="critical"
      />
      <FactCard
        label="Off-Meta Activity — your entire web history"
        text="Meta aggregates your activity from every site and app that uses its tracking tools. The Off-Facebook Activity tool lets you view and theoretically clear this data, but the profile used for targeting rebuilds immediately."
        severity="critical"
      />
      <FactCard
        label="Contact lists uploaded by others"
        text="When your contacts upload their phone books to Facebook or Instagram, your phone number and email address are included in Meta's systems — regardless of whether you have an account."
        severity="high"
      />
      <FactCard
        label="AI training on posts and photos"
        text="Meta uses public posts, comments, and photos (including their captions and metadata) to train its AI models. EU users can object. US users have no equivalent opt-out."
        severity="high"
      />
    </div>

    <div class="collect-detail">
      <p>Meta collects data in three places: on its platforms, across the web via the Meta Pixel and SDK, and from third-party data partners.</p>

      <p>On platform: everything you post, comment on, react to, and share. Who you message and when (not content). Events you mark as interested or attending. Groups you join. Search queries. Videos you watch and for how long. Products you view in Marketplace and Facebook Shops. The pages and accounts you follow, and the ones you unfollow.</p>

      <p>Off platform: The Meta Pixel is installed on millions of websites. When you visit any of those sites, your activity — pages viewed, products browsed, items added to cart, purchases completed — is reported back to Meta and added to your advertising profile. This occurs whether the site shows a cookie banner or not, whether you are logged into Facebook, and whether you have a Facebook account at all. Meta matches events to user profiles using cookies, device identifiers, email hashes, and IP address matching.</p>

      <p>From third parties: Meta purchases and licenses data from <a href="/data-brokers">data brokers</a> and business partners. This includes purchase history, loyalty program data, app usage data, and demographic enrichment. When you see an ad for something you researched on a retailer website that has no Meta Pixel, it is likely this data pipeline at work.</p>

      <p>Facebook and Instagram share a single data infrastructure via Accounts Center. Data collected on Instagram informs your Facebook ad profile and vice versa.</p>
    </div>
  </div>

  <!-- SETTINGS THAT MATTER -->
  <div slot="settings">
    {(() => {
      let lastSeverity = null;
      return platformData.settings.map((s) => {
        const showLabel = s.severity !== "critical" && s.severity !== lastSeverity;
        lastSeverity = s.severity;
        return (
          <>
            {showLabel && <h3 class="severity-group-label">{s.severity.charAt(0).toUpperCase() + s.severity.slice(1)}</h3>}
            <SettingCard
              name={s.name}
              severity={s.severity}
              defaultState={s.defaultState}
              platform={s.platform}
              path={s.path}
              webUrl={s.webUrl}
              webPath={s.webPath}
              description={s.description}
              whatItDoesnt={s.whatItDoesnt}
            />
          </>
        );
      });
    })()}
  </div>


    <div class="turnoff-group">
      <h3 class="turnoff-heading">Ad Personalization Using Partner Data</h3>
      <ol class="turnoff-steps">
        <li>Accounts Center &rarr; Ad preferences &rarr; Ad settings &rarr; Ads shown outside of Meta.</li>
        <li>Toggle off "Use data from Meta's partners to show you ads."</li>
      </ol>
    </div>

    <div class="turnoff-group">
      <h3 class="turnoff-heading">Audience Network Ads</h3>
      <ol class="turnoff-steps">
        <li>Accounts Center &rarr; Ad preferences &rarr; Ad settings &rarr; Ads shown outside of Meta.</li>
        <li>Toggle off "See Meta ads on apps and websites outside Meta."</li>
      </ol>
    </div>

    <div class="turnoff-group">
      <h3 class="turnoff-heading">Search Engine Indexing</h3>
      <ol class="turnoff-steps">
        <li>Facebook: Settings &amp; Privacy &rarr; Settings &rarr; Privacy &rarr; How people find and contact you.</li>
        <li>Tap "Do you want search engines outside of Facebook to link to your profile?"</li>
        <li>Select "No."</li>
      </ol>
    </div>

    <div class="turnoff-group">
      <h3 class="turnoff-heading">Email/Phone Lookup</h3>
      <ol class="turnoff-steps">
        <li>Settings &amp; Privacy &rarr; Settings &rarr; Privacy &rarr; How people find and contact you.</li>
        <li>Change "Who can look you up using the email address you provided?" to "Only me."</li>
        <li>Change "Who can look you up using the phone number you provided?" to "Only me."</li>
      </ol>
    </div>

    <div class="turnoff-group">
      <h3 class="turnoff-heading">Connected Third-Party Apps</h3>
      <ol class="turnoff-steps">
        <li>Settings &amp; Privacy &rarr; Settings &rarr; Security and login &rarr; Apps and websites.</li>
        <li>Review each listed app under "Active" and "Expired."</li>
        <li>Remove any app you do not recognize or no longer use.</li>
        <li>Also accessible via Accounts Center for a unified view across Facebook and Instagram.</li>
      </ol>
    </div>

    <div class="turnoff-group">
      <h3 class="turnoff-heading">Ad Topic Preferences</h3>
      <ol class="turnoff-steps">
        <li>Accounts Center &rarr; Ad preferences &rarr; Ad topics.</li>
        <li>Select topics you want to see less of. Options include alcohol, gambling, parenting, and political content.</li>
      </ol>
    </div>
  </div>

  <!-- WHO GETS YOUR DATA -->
  <div slot="who-gets-data">
    <dl class="data-recipients">
      <div class="recipient">
        <dt>Meta's Audience Network</dt>
        <dd>Thousands of third-party apps and websites that serve ads using Meta's ad platform. Your behavioral profile determines which ads you see on apps that have nothing to do with Meta.</dd>
      </div>

      <div class="recipient">
        <dt>The Meta Pixel Ecosystem</dt>
        <dd>Millions of websites that have installed Meta's tracking code. Each of these sites sends your visit data to Meta as a business arrangement. The list is not publicly disclosed.</dd>
      </div>

      <div class="recipient">
        <dt>Instagram (within Meta)</dt>
        <dd>Facebook and Instagram share a unified data infrastructure via Accounts Center. Activity on Instagram informs your Facebook ad profile and vice versa.</dd>
      </div>

      <div class="recipient">
        <dt>Meta AI</dt>
        <dd>Meta uses public posts, photos, and interactions to train its large language models, including the models powering Meta AI across its platforms. EU users can submit an objection. No equivalent process exists for US users.</dd>
      </div>

      <div class="recipient">
        <dt>WhatsApp (limited)</dt>
        <dd>WhatsApp does not use message content for ad targeting. However, metadata — who you message, how often, when — is shared with Meta and used for purposes including security and product improvement.</dd>
      </div>

      <div class="recipient">
        <dt>Data Broker Partners</dt>
        <dd>Meta licenses enrichment data from companies including Acxiom, Experian, and others to improve targeting accuracy beyond what its own tracking captures.</dd>
      </div>
    </dl>
  </div>

  <!-- WHAT THEY KNOW -->
  <div slot="what-they-know">
    <p>After a typical month of use, Meta's profile on you includes: your approximate income bracket (inferred from engagement patterns and enriched with third-party data), whether you are in a relationship and its status, your rough location history derived from IP and device signals, what you are considering purchasing (from off-platform Pixel data), what news sources you read, what health topics you have searched (via apps with Meta's SDK), and the contact information of your entire social network — including people who have never had a Facebook account but appear in your friends' contact lists.</p>

    <p>The profile is not stored as a readable document. It exists as targeting parameters in Meta's ad platform, expressed as the ads you see.</p>

    <WarningCallout title="No AI Training Opt-Out for US Users">
      <p>Meta uses public posts, photos, and interactions to train its AI models. EU users can submit a formal objection under GDPR. US users have no equivalent mechanism. The opt-out that exists for EU users does not apply in the United States. This includes content posted to Facebook, Instagram, and comments left on public pages.</p>
    </WarningCallout>
  </div>

  <!-- RELATED PRACTICES -->
  <CrossLinkChip slot="related-practices" href="/practices/off-platform-tracking" label="Off-Platform Activity Tracking" type="practice" />
  <CrossLinkChip slot="related-practices" href="/practices/ai-training" label="AI Training Data Usage" type="practice" />
  <CrossLinkChip slot="related-practices" href="/practices/ad-personalization" label="Ad Personalization" type="practice" />
  <CrossLinkChip slot="related-practices" href="/practices/third-party-sharing" label="Third-Party Data Sharing" type="practice" />
  <CrossLinkChip slot="related-practices" href="/rights/gdpr" label="GDPR (€1.2B fine, EU AI opt-out)" type="practice" />
  <CrossLinkChip slot="related-practices" href="/rights/ccpa" label="CCPA (Do Not Sell)" type="practice" />

  <!-- RELATED PLATFORMS -->
  <CrossLinkChip slot="related-platforms" href="/platforms/tiktok" label="TikTok" type="platform" />
  <CrossLinkChip slot="related-platforms" href="/platforms/x" label="X / Twitter" type="platform" />
  <CrossLinkChip slot="related-platforms" href="/data-brokers/acxiom" label="Acxiom" type="platform" />

</PlatformLayout>

<style>
  .fact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .collect-detail {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
  }

  p {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  p:last-child {
    margin-bottom: 0;
  }

  .severity-group-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 1.75rem 0 0.75rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--color-border);
  }

  .severity-group-label:first-child {
    margin-top: 0;
  }

  .turnoff-group {
    margin-bottom: 1.5rem;
  }

  .turnoff-group:last-child {
    margin-bottom: 0;
  }

  .turnoff-heading {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .turnoff-steps {
    padding-left: 1.25rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .turnoff-steps li {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .data-recipients {
    margin: 0;
  }

  .recipient {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .recipient:first-child {
    padding-top: 0;
  }

  .recipient:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .recipient dt {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.375rem;
  }

  .recipient dd {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }
</style>
