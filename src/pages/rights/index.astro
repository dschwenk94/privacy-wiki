---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

type Law = {
  name: string;
  href: string | null;
  jurisdiction: string;
  status: 'live' | 'coming-soon';
  description: string;
};

const laws: Law[] = [
  {
    name: 'Colorado Privacy Act (CPA)',
    href: '/rights/colorado',
    jurisdiction: 'Colorado (State)',
    status: 'live',
    description: 'Effective July 2023. Requires businesses to honor Global Privacy Control browser signals as opt-outs from targeted advertising and data sales. The most mechanically actionable US state privacy law for most consumers.',
  },
  {
    name: 'CCPA / CPRA',
    href: null,
    jurisdiction: 'California (State)',
    status: 'coming-soon',
    description: 'The California Consumer Privacy Act and its 2020 amendment. Strongest state-level rights in the US — right to know, delete, correct, and opt out of data sales. Enforced by the California Privacy Protection Agency.',
  },
  {
    name: 'GDPR',
    href: null,
    jurisdiction: 'European Union',
    status: 'coming-soon',
    description: 'The General Data Protection Regulation. Broad rights including access, erasure, portability, and the right to object to processing. Requires affirmative consent for most data collection. Applies to any company processing EU resident data.',
  },
  {
    name: 'COPPA',
    href: null,
    jurisdiction: 'United States (Federal)',
    status: 'coming-soon',
    description: 'The Children\'s Online Privacy Protection Act. Restricts collection of personal data from children under 13. Requires parental consent. The FTC enforces it — violations carry significant fines.',
  },
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Your Rights' },
];
---

<BaseLayout
  title="Your Rights — Privacy Wiki"
  description="The laws that give you leverage over how companies collect and use your data — what they cover, where they apply, and where the gaps are."
>
  <div class="page-container">
    <header class="page-header">
      <Breadcrumb crumbs={breadcrumbs} />
      <h1 class="page-title">Your Rights</h1>
      <p class="page-subtitle">
        These are the laws that give you leverage — what they cover, where they
        apply, and where the gaps are. Consumer privacy law is fragmented:
        rights vary by state, enforcement varies by agency, and most laws have
        meaningful carve-outs.
      </p>
    </header>

    <main>
      <ul class="law-list">
        {laws.map((law) => (
          <li class="law-item">
            {law.href ? (
              <a href={law.href} class="law-link">
                <div class="law-header">
                  <span class="law-name">{law.name}</span>
                  <span class="law-status status--live">LIVE</span>
                </div>
                <div class="law-meta">
                  <span class="law-jurisdiction">{law.jurisdiction}</span>
                </div>
                <p class="law-desc">{law.description}</p>
              </a>
            ) : (
              <div class="law-link law-link--inert">
                <div class="law-header">
                  <span class="law-name">{law.name}</span>
                  <span class="law-status status--soon">COMING SOON</span>
                </div>
                <div class="law-meta">
                  <span class="law-jurisdiction">{law.jurisdiction}</span>
                </div>
                <p class="law-desc">{law.description}</p>
              </div>
            )}
          </li>
        ))}
      </ul>
    </main>

    <footer class="page-footer">
      <p class="footer-note">
        These pages focus on rights that are actionable for most people —
        specific mechanisms, concrete steps, and honest assessments of what
        each law actually does versus what it says.
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2.5rem;
    padding-top: 1.5rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 600;
    margin: 0.75rem 0 0.625rem;
    color: var(--color-text-primary);
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 580px;
    line-height: 1.7;
    margin: 0;
  }

  .law-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .law-item {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: border-color 0.15s ease;
  }

  .law-item:has(a):hover {
    border-color: #3a3a3a;
  }

  .law-link {
    display: block;
    padding: 1rem 1.25rem;
    text-decoration: none;
  }

  .law-link:hover {
    text-decoration: none;
  }

  .law-link--inert {
    opacity: 0.65;
    cursor: default;
  }

  .law-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.375rem;
  }

  .law-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .law-status {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    border-radius: 2px;
    padding: 0.15em 0.5em;
    border: 1px solid;
    flex-shrink: 0;
  }

  .status--live {
    color: var(--color-high);
    border-color: var(--color-high);
  }

  .status--soon {
    color: var(--color-text-muted);
    border-color: var(--color-border);
  }

  .law-meta {
    margin-bottom: 0.375rem;
  }

  .law-jurisdiction {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .law-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .page-footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }
</style>
