---
import BaseLayout from '../layouts/BaseLayout.astro';

const platforms: Array<{ name: string; href: string; description: string }> = [
  {
    name: 'TikTok',
    href: '/platforms/tiktok',
    description: 'Off-platform tracking via TikTok Pixel, GPS collection added in 2026, no AI training opt-out for US users.',
  },
  {
    name: 'X / Twitter',
    href: '/platforms/x',
    description: 'Default-on Grok AI training added in 2024, data sharing with unspecified business partners, cross-device targeting.',
  },
  {
    name: 'Meta / Instagram',
    href: '/platforms/meta',
    description: 'The Meta Pixel tracks you across millions of third-party websites. Off-Facebook Activity, Audience Network ads, AI training with no US opt-out.',
  },
  {
    name: 'Google',
    href: '/platforms/google',
    description: 'Google Analytics and the Google Ads network reach roughly 90% of top websites. Cross-product data from Search, YouTube, Maps, Gmail, Chrome, and Android.',
  },
  {
    name: 'Amazon',
    href: '/platforms/amazon',
    description: 'Purchase history, Alexa voice recordings, Ring footage, cross-site ad network, and Amazon One palm biometrics. A household-level behavioral profile.',
  },
  {
    name: 'YouTube',
    href: '/platforms/youtube',
    description: 'A Google product. Watch history, search queries, and granular engagement data feed the same Google advertising profile used across Search, Gmail, and the Display Network.',
  },
];
const practices: Array<{ name: string; href: string; description: string }> = [
  {
    name: 'Off-Platform Activity Tracking',
    href: '/practices/off-platform-tracking',
    description: 'When you close the app, the tracking does not stop. How platforms monitor behavior across the rest of the internet.',
  },
  {
    name: 'AI Training Data Usage',
    href: '/practices/ai-training',
    description: 'Most platforms are using your content to train AI models by default. Opt-outs are forward-looking only.',
  },
  {
    name: 'Ad Personalization and Targeting',
    href: '/practices/ad-personalization',
    description: 'Turning off personalized ads does not stop data collection. What the toggle actually controls.',
  },
  {
    name: 'Third-Party Data Sharing',
    href: '/practices/third-party-sharing',
    description: 'Platforms share your data with companies you have never interacted with. What leaves the platform and where it goes.',
  },
  {
    name: 'Data Brokers',
    href: '/practices/data-brokers',
    description: 'Profiles built from public records, purchase history, and behavioral data — sold without your involvement. Opt-outs are piecemeal.',
  },
  {
    name: 'Location Data',
    href: '/practices/location-data',
    description: 'Your location is collected continuously, sold by data brokers, and purchased by advertisers and government agencies. A location history reveals home, workplace, and medical visits.',
  },
  {
    name: 'Dark Patterns',
    href: '/practices/dark-patterns',
    description: 'Deliberate interface design that makes consent frictionless and opt-out hard. The toggle exists; it is just buried, grayed out, and three submenus away.',
  },
];
---

<BaseLayout
  title="Privacy Wiki — What They Collect. How To Turn It Off."
  description="A reference site for understanding how consumer technology platforms collect, share, and monetize your data — and exactly how to turn those settings off."
>
  <div class="page-container">
    <header class="site-header">
      <div class="site-eyebrow">privacywiki.io</div>
      <h1 class="site-title">Privacy Wiki</h1>
      <p class="site-description">
        What they collect. Why it matters. How to turn it off.
      </p>
      <p class="site-subtext">
        A plain account of how consumer platforms collect, share, and monetize
        your data, and the exact steps to limit it. Written from the inside.
      </p>
    </header>

    <hr class="divider" />

    <main>
      <section class="index-section">
        <div class="section-header">
          <h2 class="section-heading">Platforms</h2>
          <a href="/platforms" class="section-link">All platforms →</a>
        </div>
        <p class="section-desc">
          One page per company. What they collect, which settings matter, and
          how to turn them off.
        </p>

        {platforms.length > 0 ? (
          <ul class="page-list">
            {platforms.map((p) => (
              <li class="page-list-item">
                <a href={p.href} class="page-list-link">
                  <span class="page-list-name">{p.name}</span>
                  <span class="page-list-desc">{p.description}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty-state">
            <span class="empty-label">Coming soon</span>
            <p class="empty-text">
              TikTok, Meta/Instagram, X — and more. Pages are being built now.
            </p>
          </div>
        )}
      </section>

      <hr class="divider" />

      <section class="index-section">
        <div class="section-header">
          <h2 class="section-heading">Practices</h2>
          <a href="/practices" class="section-link">All practices →</a>
        </div>
        <p class="section-desc">
          One page per data collection technique. How it works across every
          platform that uses it.
        </p>

        {practices.length > 0 ? (
          <ul class="page-list">
            {practices.map((p) => (
              <li class="page-list-item">
                <a href={p.href} class="page-list-link">
                  <span class="page-list-name">{p.name}</span>
                  <span class="page-list-desc">{p.description}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty-state">
            <span class="empty-label">Coming soon</span>
            <p class="empty-text">
              Off-Platform Activity Tracking, AI Training Data Usage, Ad
              Personalization &amp; Targeting — pages in progress.
            </p>
          </div>
        )}
      </section>
    </main>

    <footer class="site-footer">
      <p class="footer-note">
        Built by someone who works in ad tech. Verified against live settings,
        not marketing copy.
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .site-header {
    padding: 3rem 0 2rem;
  }

  .site-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .site-title {
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .site-description {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .site-subtext {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 560px;
    line-height: 1.7;
    margin-bottom: 0;
  }

  .index-section {
    padding: 2rem 0;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .section-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .section-link:hover {
    color: var(--color-accent-blue);
    text-decoration: none;
  }

  .section-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    max-width: 520px;
    line-height: 1.6;
  }

  .page-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .page-list-item {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: border-color 0.15s ease;
  }

  .page-list-item:hover {
    border-color: #3a3a3a;
  }

  .page-list-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
  }

  .page-list-link:hover {
    text-decoration: none;
  }

  .page-list-name {
    font-weight: 500;
    color: var(--color-text-primary);
    font-size: 0.9375rem;
    flex-shrink: 0;
  }

  .page-list-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .empty-state {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 1.25rem 1.5rem;
  }

  .empty-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 0.15em 0.5em;
    margin-bottom: 0.625rem;
  }

  .empty-text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .site-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
