---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const practices: Array<{
  name: string;
  href: string;
  severity: 'critical' | 'high' | 'medium';
  description: string;
  platformCount?: number;
}> = [
  {
    name: 'Off-Platform Activity Tracking',
    href: '/practices/off-platform-tracking',
    severity: 'critical',
    description: 'When you close the app, the tracking does not stop. How platforms monitor your behavior across the rest of the internet.',
    platformCount: 4,
  },
  {
    name: 'AI Training Data Usage',
    href: '/practices/ai-training',
    severity: 'high',
    description: 'Most platforms are using your content to train AI models by default. Opt-outs are forward-looking only.',
    platformCount: 6,
  },
  {
    name: 'Ad Personalization and Targeting',
    href: '/practices/ad-personalization',
    severity: 'high',
    description: 'Turning off personalized ads does not stop data collection. What the toggle most users find actually controls.',
    platformCount: 4,
  },
  {
    name: 'Third-Party Data Sharing',
    href: '/practices/third-party-sharing',
    severity: 'critical',
    description: 'Platforms share your data with companies you have never interacted with. What policy language actually covers.',
    platformCount: 5,
  },
  {
    name: 'Data Brokers',
    href: '/practices/data-brokers',
    severity: 'critical',
    description: 'Data brokers compile profiles from public records, purchase history, and behavioral data and sell them. Opt-outs are piecemeal and do not cover B2B brokers.',
  },
  {
    name: 'Location Data',
    href: '/practices/location-data',
    severity: 'critical',
    description: 'Your location is collected continuously by apps, sold by data brokers, and purchased by advertisers, hedge funds, and government agencies. A location history reveals home, workplace, medical providers, and political activity.',
    platformCount: 4,
  },
  {
    name: 'Dark Patterns',
    href: '/practices/dark-patterns',
    severity: 'high',
    description: 'The toggle is there. It is just hard to find, confusing to use, and designed to make you give up. How deliberate interface design maximizes data collection while maintaining technical compliance.',
    platformCount: 4,
  },
  {
    name: 'Automatic Content Recognition (ACR)',
    href: '/practices/acr',
    severity: 'critical',
    description: 'Your smart TV captures what\'s on screen every few seconds and sells that viewership data. Works regardless of content source — cable, streaming, game console, antenna. Enabled by default on virtually every major brand.',
    platformCount: 5,
  },
  {
    name: 'Cross-Device Graph Matching',
    href: '/practices/cross-device',
    severity: 'high',
    description: 'How companies link your TV, phone, laptop, and tablet into a single identity profile — without shared logins. IP correlation, timing patterns, and shared account data connect devices. Clearing cookies does not help.',
    platformCount: 5,
  },
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Practices' },
];
---

<BaseLayout
  title="Practices — Privacy Wiki"
  description="Guides to specific data collection practices: off-platform tracking, AI training data usage, ad personalization, third-party data sharing, and more."
>
  <div class="page-container">
    <header class="page-header">
      <Breadcrumb crumbs={breadcrumbs} />
      <h1 class="page-title">Practices</h1>
      <p class="page-subtitle">
        One page per data collection technique. Each practice page explains
        what the technique is, how it works, which platforms use it, and how
        to limit it — across all platforms at once.
      </p>
    </header>

    <main>
      {practices.length > 0 ? (
        <ul class="practice-list">
          {practices.map((p) => (
            <li class="practice-item">
              <a href={p.href} class="practice-link">
                <div class="practice-header">
                  <span class="practice-name">{p.name}</span>
                  <span class={`severity-badge severity--${p.severity}`}>
                    {p.severity.toUpperCase()}
                  </span>
                </div>
                {p.platformCount !== undefined && (
                  <div class="practice-meta">
                    <span class="platform-count">
                      {p.platformCount} platforms
                    </span>
                  </div>
                )}
                <p class="practice-desc">{p.description}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-state">
          <div class="empty-header">
            <span class="empty-label">In progress</span>
          </div>
          <p class="empty-text">
            Practice pages explain the mechanics behind data collection — the
            techniques that every platform uses under different names. First up:
            the practices that surprise people most.
          </p>
          <ul class="upcoming-list">
            <li>Off-Platform Activity Tracking — how closing the app doesn't stop the tracking</li>
            <li>AI Training Data Usage — your posts as training data, by default</li>
            <li>Ad Personalization &amp; Targeting — what "turning off" personalized ads actually does</li>
            <li>Third-Party Data Sharing — where your data goes after it leaves the platform</li>
          </ul>
        </div>
      )}
    </main>

    <footer class="page-footer">
      <p class="footer-note">
        Practice pages cross-link to platform pages and to each other.
        That's the point — understanding how these techniques work across
        platforms is more useful than reading about them one at a time.
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2.5rem;
    padding-top: 1.5rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 600;
    margin: 0.75rem 0 0.625rem;
    color: var(--color-text-primary);
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 580px;
    line-height: 1.7;
    margin: 0;
  }

  .practice-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .practice-item {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: border-color 0.15s ease;
  }

  .practice-item:hover {
    border-color: #3a3a3a;
  }

  .practice-link {
    display: block;
    padding: 1rem 1.25rem;
    text-decoration: none;
  }

  .practice-link:hover {
    text-decoration: none;
  }

  .practice-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.375rem;
  }

  .practice-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .severity-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    border-radius: 2px;
    padding: 0.15em 0.5em;
    border: 1px solid;
  }

  .severity--critical {
    color: var(--color-critical);
    border-color: var(--color-critical);
  }

  .severity--high {
    color: var(--color-high);
    border-color: var(--color-high);
  }

  .severity--medium {
    color: var(--color-medium);
    border-color: var(--color-medium);
  }

  .practice-meta {
    margin-bottom: 0.375rem;
  }

  .platform-count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .practice-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .empty-state {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 1.5rem 1.75rem;
  }

  .empty-header {
    margin-bottom: 0.75rem;
  }

  .empty-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 0.15em 0.5em;
  }

  .empty-text {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .upcoming-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .upcoming-list li {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    padding-left: 1rem;
    position: relative;
    line-height: 1.5;
  }

  .upcoming-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  .page-footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.7;
  }
</style>
