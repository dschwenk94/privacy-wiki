---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
} = Astro.props;

const siteUrl = 'https://privacywiki.io';
const resolvedCanonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
const resolvedOgImage = ogImage ?? `${siteUrl}/og-default.png`;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: resolvedCanonical,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Privacy Wiki',
    url: siteUrl,
  },
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={resolvedOgImage} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={resolvedOgImage} />}

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={jsonLd} />

    <!-- ANALYTICS: add Plausible script tag here before launch -->
  </head>
  <body>
    <nav class="site-nav">
      <a href="/" class="nav-home">PrivacyWiki</a>
      <div class="nav-links">
        <a href="/your-exposure" class="nav-link">Your Exposure</a>
        <a href="/platforms" class="nav-link">Platforms</a>
      </div>
    </nav>
    <slot />
  </body>
</html>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .nav-home {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav-home:hover {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--color-text-secondary);
    text-decoration: none;
  }
</style>
