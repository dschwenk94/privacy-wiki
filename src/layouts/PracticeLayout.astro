---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SeverityBanner from '../components/SeverityBanner.astro';
import PracticeInfobox from '../components/PracticeInfobox.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  title: string;
  description: string;
  subtitle: string;
  lastVerified: string;
  platformCount: number;
  severity: 'critical' | 'high' | 'medium';
  severityText: string;
  category?: string;
  alsoKnownAs?: string;
  platforms?: string[];
  canonicalUrl?: string;
  ogImage?: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const {
  title,
  description,
  subtitle,
  lastVerified,
  platformCount,
  severity,
  severityText,
  category = 'Data Collection Practice',
  alsoKnownAs,
  platforms = [],
  canonicalUrl,
  ogImage,
  breadcrumbs: breadcrumbsProp,
} = Astro.props;

const breadcrumbs = breadcrumbsProp ?? [
  { label: 'Home', href: '/' },
  { label: 'Data Practices', href: '/practices' },
  { label: title },
];
---

<BaseLayout {title} {description} {canonicalUrl} {ogImage}>
  <div class="site-nav">
    <div class="nav-logo">Privacy<span>Wiki</span></div>
    <span class="nav-sep">/</span>
    <a href="/platforms">Platforms</a>
    <a href="/practices">Data Practices</a>
  </div>

  <div class="breadcrumb-wrap">
    <Breadcrumb crumbs={breadcrumbs} />
  </div>

  <div class="page-wrap">
    <!-- MAIN CONTENT -->
    <main class="content-main">
      <h1 class="page-title">{title}</h1>
      {subtitle && <p class="page-subtitle">{subtitle}</p>}

      <SeverityBanner level={severity} text={severityText} />

      <section class="page-section" id="what-it-is" aria-labelledby="what-it-is-heading">
        <h2 id="what-it-is-heading" class="section-heading">What It Is</h2>
        <slot name="what-it-is">
          <p class="placeholder-text">Content coming soon.</p>
        </slot>
      </section>

      <hr class="divider" />

      <section class="page-section" id="how-to-turn-off" aria-labelledby="how-to-turn-off-heading">
        <h2 id="how-to-turn-off-heading" class="section-heading">How To Turn It Off</h2>
        <slot name="how-to-turn-off">
          <p class="placeholder-text">Per-platform instructions coming soon.</p>
        </slot>
      </section>

      <hr class="divider" />

      <section class="page-section" id="why-it-matters" aria-labelledby="why-it-matters-heading">
        <h2 id="why-it-matters-heading" class="section-heading">Why It Matters</h2>
        <slot name="why-it-matters">
          <p class="placeholder-text">Content coming soon.</p>
        </slot>
      </section>

      <hr class="divider" />

      <section class="page-section" id="how-it-works" aria-labelledby="how-it-works-heading">
        <h2 id="how-it-works-heading" class="section-heading">How It Works</h2>
        <slot name="how-it-works">
          <p class="placeholder-text">Technical flow coming soon.</p>
        </slot>
      </section>

      <hr class="divider" />

      <section class="page-section" id="who-has-data" aria-labelledby="who-has-data-heading">
        <h2 id="who-has-data-heading" class="section-heading">Who Has Your Data</h2>
        <slot name="who-has-data">
          <p class="placeholder-text">Platform table coming soon.</p>
        </slot>
      </section>

      <hr class="divider" />

      <section class="page-section" id="related" aria-labelledby="related-heading">
        <h2 id="related-heading" class="section-heading">Related</h2>
        <h4 class="related-sub-heading">Data Practices</h4>
        <div class="chip-group">
          <slot name="related-practices">
            <p class="placeholder-text">Practice cross-links coming soon.</p>
          </slot>
        </div>
        <h4 class="related-sub-heading" style="margin-top: 1rem;">Platforms</h4>
        <div class="chip-group">
          <slot name="related-platforms">
            <p class="placeholder-text">Platform cross-links coming soon.</p>
          </slot>
        </div>
      </section>

      <footer class="page-footer">
        <p class="footer-updated">Last updated: {lastVerified}</p>
        <p class="footer-feedback">
          Something changed?
          <a href="mailto:feedback@privacywiki.io">Let us know.</a>
        </p>
      </footer>
    </main>

    <!-- SIDEBAR -->
    <aside class="sidebar">
      <PracticeInfobox
        title={title}
        category={category}
        alsoKnownAs={alsoKnownAs}
        platforms={platforms}
        severity={severity}
        lastUpdated={lastVerified}
      />
      <div class="toc-wrap">
        <TableOfContents items={[
          { label: 'What It Is', href: '#what-it-is' },
          { label: 'How To Turn It Off', href: '#how-to-turn-off' },
          { label: 'Why It Matters', href: '#why-it-matters' },
          { label: 'How It Works', href: '#how-it-works' },
          { label: 'Who Has Your Data', href: '#who-has-data' },
          { label: 'Related', href: '#related' },
        ]} />
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .site-nav {
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    position: sticky;
    top: 0;
    background: var(--color-bg);
    z-index: 100;
  }

  .nav-logo {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .nav-logo span {
    color: var(--color-critical);
  }

  .site-nav a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .site-nav a:hover {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .nav-sep {
    color: var(--color-border);
  }

  .breadcrumb-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem 0;
  }

  .page-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 2rem 4rem;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2.5rem;
    align-items: start;
  }

  .content-main {
    min-width: 0;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.25rem;
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .page-subtitle {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 2rem;
    max-width: 640px;
  }

  .section-heading {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-bottom: 0.625rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    margin-top: 0;
  }

  .page-section {
    margin-bottom: 0;
  }

  .related-sub-heading {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sidebar {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .placeholder-text {
    color: var(--color-text-muted);
    font-style: italic;
    font-size: 0.9375rem;
  }

  .page-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-updated,
  .footer-feedback {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer-feedback a {
    color: var(--color-text-secondary);
  }

  .footer-feedback a:hover {
    color: var(--color-text-primary);
  }

  @media (max-width: 900px) {
    .page-wrap {
      grid-template-columns: 1fr;
      padding: 1.25rem 1rem 3rem;
    }

    .sidebar {
      position: static;
      order: -1;
    }

    .toc-wrap {
      display: none;
    }

    .site-nav {
      padding: 0.75rem 1rem;
      gap: 1rem;
    }

    .breadcrumb-wrap {
      padding: 1rem 1rem 0;
    }
  }
</style>
