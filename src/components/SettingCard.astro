---
interface Props {
  name: string;
  severity: 'critical' | 'high' | 'medium';
  defaultState: string;
  description: string;
  whatItDoesnt?: string;
  howToTurnOff?: string;
  webUrl?: string;
  webPath?: string[];
}

const {
  name,
  severity,
  defaultState,
  description,
  whatItDoesnt,
  howToTurnOff,
  webUrl,
  webPath,
} = Astro.props;

const severityColors = {
  critical: '#e53e3e',
  high:     '#d69e2e',
  medium:   '#b7791f',
};

const color = severityColors[severity];
---

<div class="setting-card" style={`--sev-color: ${color}`}>
  <div class="card-header">
    <h3 class="setting-name">{name}</h3>
    <div class="setting-meta">
      <span class="severity-pill">{severity.toUpperCase()}</span>
      <span class="default-state">
        Default: <strong>{defaultState}</strong>
      </span>
    </div>
  </div>

  {webUrl && webPath && (
    <div class="path-group">
      <span class="path-device-label">Web</span>
      <div class="setting-path web-path">
        <a class="web-link" href={webUrl} target="_blank" rel="noopener noreferrer">
          {webUrl.replace(/^https?:\/\//, '')}
        </a>
        <span class="arrow" aria-hidden="true">›</span>
        <ol class="path-steps">
          {webPath.map((step, i) => (
            <li class="path-step">
              <span class="step-text">{step}</span>
              {i < webPath.length - 1 && <span class="arrow" aria-hidden="true">›</span>}
            </li>
          ))}
        </ol>
      </div>
    </div>
  )}

  <p class="setting-description">{description}</p>

  {howToTurnOff && (
    <p class="how-to-turn-off">
      <span class="turn-off-label">Turn off:</span> {howToTurnOff}
    </p>
  )}

  {whatItDoesnt && (
    <p class="what-it-doesnt">
      <span class="doesnt-label">Note:</span> {whatItDoesnt}
    </p>
  )}
</div>

<style>
  .setting-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--sev-color);
    border-radius: 0 0 4px 4px;
    padding: 1.125rem 1.25rem;
    margin-bottom: 1rem;
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .setting-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .setting-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .severity-pill {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--sev-color);
    border: 1px solid var(--sev-color);
    border-radius: 2px;
    padding: 0.1em 0.5em;
  }

  .default-state {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .default-state strong {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .path-group {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0.375rem 0;
  }

  .path-device-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-top: 0.7rem;
    min-width: 2.75rem;
    flex-shrink: 0;
  }

  .path-group :global(.setting-path) {
    flex: 1;
    margin: 0;
  }

  .web-path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.625rem 0.875rem;
    flex: 1;
  }

  .web-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent-blue);
    text-decoration: none;
    white-space: nowrap;
  }

  .web-link:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .web-path .arrow {
    color: var(--color-text-muted);
    margin: 0 0.125rem;
    font-size: 0.9375rem;
    line-height: 1;
  }

  .web-path .path-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
  }

  .web-path .path-step {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .web-path .step-text {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .setting-description {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  .what-it-doesnt {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-top: 0.625rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--color-border);
    margin-bottom: 0;
  }

  .doesnt-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-right: 0.25rem;
  }

  .how-to-turn-off {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
    margin-bottom: 0;
  }

  .turn-off-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-right: 0.25rem;
  }
</style>
