---
interface Props {
  name: string;
  severity: 'critical' | 'high' | 'medium';
  defaultState: string;
  description: string;
  whatItDoesnt?: string;
  howToTurnOff?: string;
  webUrl?: string;
  webPath?: string[];
  platform?: string;
  path?: string[];
}

const {
  name,
  severity,
  defaultState,
  description,
  whatItDoesnt,
  howToTurnOff,
  webUrl,
  webPath,
  platform,
  path,
} = Astro.props;

const severityColors: Record<string, string> = {
  critical: '#e53e3e',
  high:     '#d69e2e',
  medium:   '#b7791f',
};

const color = severityColors[severity];

const severityLabel = severity.charAt(0).toUpperCase() + severity.slice(1);
---

<details class="setting-detail" style={`--sev-color: ${color}`}>
  <summary class="setting-summary">
    <div class="summary-left">
      <span class="sev-dot"></span>
      <span class="setting-name">{name}</span>
      <span class="severity-pill">{severityLabel}</span>
    </div>
    <div class="summary-right">
      <span class="default-badge">Default: {defaultState}</span>
      <span class="toggle-icon" aria-hidden="true">&#9654;</span>
    </div>
  </summary>

  <div class="setting-body">
    {(webUrl || webPath || path) && (
      <div class="setting-path-full">
        {webUrl && (
          <a class="web-link" href={webUrl} target="_blank" rel="noopener noreferrer">
            {webUrl.replace(/^https?:\/\//, '')}
          </a>
        )}
        {webPath && webPath.length > 0 && (
          <span class="path-steps">
            {webPath.map((step, i) => (
              <span>
                <span class="path-arrow">&rsaquo;</span>
                <span class="path-step">{step}</span>
              </span>
            ))}
          </span>
        )}
        {!webPath && path && path.length > 0 && (
          <span class="path-steps">
            {path.map((step, i) => (
              <span>
                {i > 0 && <span class="path-arrow">&rsaquo;</span>}
                <span class="path-step">{step}</span>
              </span>
            ))}
          </span>
        )}
      </div>
    )}

    <p class="setting-description">{description}</p>

    {howToTurnOff && (
      <p class="how-to-turn-off">
        <span class="turn-off-label">Turn off:</span> {howToTurnOff}
      </p>
    )}

    {whatItDoesnt && (
      <p class="what-it-doesnt">
        <span class="doesnt-label">Note:</span> {whatItDoesnt}
      </p>
    )}
  </div>
</details>

<style>
  .setting-detail {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    margin-bottom: 0.75rem;
  }

  .setting-detail[open] .toggle-icon {
    transform: rotate(90deg);
  }

  .setting-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.875rem 1.125rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    gap: 0.75rem;
  }

  .setting-summary::-webkit-details-marker {
    display: none;
  }

  .setting-summary:hover {
    background: var(--color-surface-raised);
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
  }

  .summary-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .sev-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sev-color);
    flex-shrink: 0;
  }

  .setting-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .severity-pill {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--sev-color);
    border: 1px solid var(--sev-color);
    padding: 0.1em 0.5em;
    flex-shrink: 0;
  }

  .default-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    background: var(--color-surface-raised);
    white-space: nowrap;
  }

  .toggle-icon {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    transition: transform 0.2s;
    display: inline-block;
  }

  /* body */
  .setting-body {
    padding: 0.875rem 1.125rem 1rem;
    border-top: 1px solid var(--color-border);
    border-left: 3px solid var(--sev-color);
  }

  .setting-path-full {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }

  .web-link {
    color: var(--color-accent-blue);
    text-decoration: none;
  }

  .web-link:hover {
    text-decoration: underline;
  }

  .path-steps {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }

  .path-arrow {
    color: var(--color-text-muted);
    margin: 0 0.1rem;
  }

  .path-step {
    color: var(--color-text-secondary);
  }

  .setting-description {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 0;
  }

  .what-it-doesnt {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-style: italic;
    line-height: 1.65;
    margin-top: 0.625rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--color-border);
    margin-bottom: 0;
  }

  .doesnt-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-right: 0.25rem;
    font-style: normal;
  }

  .how-to-turn-off {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-top: 0.625rem;
    margin-bottom: 0;
  }

  .turn-off-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-right: 0.25rem;
  }
</style>
