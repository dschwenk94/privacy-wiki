---
interface Props {
  level: 'critical' | 'high' | 'medium';
  text: string;
}

const { level, text } = Astro.props;

const config = {
  critical: { label: 'TLDR', color: '#e53e3e' },
  high:     { label: 'HIGH',     color: '#d69e2e' },
  medium:   { label: 'MEDIUM',   color: '#b7791f' },
};

const { label, color } = config[level];
---

<div class="severity-banner" style={`--severity-color: ${color}`}>
  <span class="severity-label">{label}</span>
  <span class="severity-text">{text}</span>
</div>

<style>
  .severity-banner {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.875rem 1.125rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--severity-color);
    border-radius: 0 4px 4px 0;
    margin: 1.25rem 0;
  }

  .severity-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--severity-color);
    flex-shrink: 0;
  }

  .severity-text {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
</style>
