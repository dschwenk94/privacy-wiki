---
interface Props {
  label: string;
  text: string;
  severity?: 'critical' | 'high' | 'medium' | 'neutral';
}

const { label, text, severity = 'neutral' } = Astro.props;

const colors = {
  critical: '#e53e3e',
  high: '#d69e2e',
  medium: '#b7791f',
  neutral: 'var(--color-text-muted)',
};

const color = colors[severity];
---

<div class="fact-card" style={`--card-accent: ${color}`}>
  <span class="fact-label">{label}</span>
  <p class="fact-text">{text}</p>
</div>

<style>
  .fact-card {
    padding: 1rem 1.125rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--card-accent);
    border-radius: 0 0 4px 4px;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .fact-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--card-accent);
  }

  .fact-text {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
  }
</style>
