---
interface Props {
  title: string;
  category: string;
  alsoKnownAs?: string;
  platforms?: string[];
  severity: 'critical' | 'high' | 'medium';
  lastUpdated: string;
}

const {
  title,
  category,
  alsoKnownAs,
  platforms = [],
  severity,
  lastUpdated,
} = Astro.props;
---

<div class="practice-infobox">
  <div class="infobox-logo">
    <span class="infobox-practice-name">{title}</span>
  </div>
  <div class="infobox-rows">
    <div class="infobox-row">
      <div class="infobox-label">Category</div>
      <div class="infobox-value">{category}</div>
    </div>
    {alsoKnownAs && (
      <div class="infobox-row">
        <div class="infobox-label">Also known as</div>
        <div class="infobox-value">{alsoKnownAs}</div>
      </div>
    )}
    <div class="infobox-row">
      <div class="infobox-label">Severity</div>
      <div class="infobox-value">
        <span class={`sev-dot sev-dot--${severity}`}></span>{severity.charAt(0).toUpperCase() + severity.slice(1)}
      </div>
    </div>
    {platforms.length > 0 && (
      <div class="infobox-row infobox-row--column">
        <div class="infobox-label infobox-label--full">Platforms</div>
        <div class="infobox-platforms">
          {platforms.map(p => (
            <span class="platform-tag">{p}</span>
          ))}
        </div>
      </div>
    )}
    <div class="infobox-row">
      <div class="infobox-label">Updated</div>
      <div class="infobox-value">
        <span class="verified-check">&#10003;&ensp;</span><span class="verified-date">{lastUpdated}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .practice-infobox {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    width: 100%;
  }

  .infobox-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-raised);
  }

  .infobox-practice-name {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
    text-align: center;
    line-height: 1.4;
  }

  .infobox-rows {}

  .infobox-row {
    display: flex;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.8125rem;
  }

  .infobox-row:last-child {
    border-bottom: none;
  }

  .infobox-row--column {
    flex-direction: column;
  }

  .infobox-label {
    width: 110px;
    flex-shrink: 0;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: rgba(17, 17, 17, 0.5);
    border-right: 1px solid var(--color-border);
    display: flex;
    align-items: center;
  }

  .infobox-label--full {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid var(--color-border);
  }

  .infobox-value {
    padding: 0.5rem 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.5;
    flex: 1;
    min-width: 0;
  }

  .sev-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-right: 0.375rem;
    position: relative;
    top: -1px;
  }

  .sev-dot--critical { background: var(--color-critical); }
  .sev-dot--high { background: var(--color-high); }
  .sev-dot--medium { background: var(--color-medium); }

  .verified-check {
    color: var(--color-text-muted);
  }

  .verified-date {
    color: var(--color-text-secondary);
  }

  .infobox-platforms {
    padding: 0.625rem 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .platform-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    background: var(--color-surface-raised);
  }
</style>
