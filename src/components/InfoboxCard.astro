---
interface Practice {
  label: string;
  href: string;
}

interface Props {
  title: string;
  category: string;
  owner: string;
  ownerHQ: string;
  headquarters: string;
  monthlyUsers: string;
  settingsCount: number;
  severity: 'critical' | 'high' | 'medium';
  lastVerified: string;
  relatedPractices?: Practice[];
}

const {
  title,
  category,
  owner,
  ownerHQ,
  headquarters,
  monthlyUsers,
  settingsCount,
  severity,
  lastVerified,
  relatedPractices = [],
} = Astro.props;
---

<div class="infobox">
  <div class="infobox-logo">
    <span class="infobox-platform-name">{title}</span>
  </div>
  <div class="infobox-rows">
    <div class="infobox-row">
      <div class="infobox-label">Category</div>
      <div class="infobox-value">{category}</div>
    </div>
    <div class="infobox-row">
      <div class="infobox-label">Owner</div>
      <div class="infobox-value">
        {owner}<br />
        <span class="infobox-sub">{ownerHQ}</span>
      </div>
    </div>
    <div class="infobox-row">
      <div class="infobox-label">HQ</div>
      <div class="infobox-value">{headquarters}</div>
    </div>
    <div class="infobox-row">
      <div class="infobox-label">MAU</div>
      <div class="infobox-value">{monthlyUsers}</div>
    </div>
    <div class="infobox-row">
      <div class="infobox-label">Settings</div>
      <div class="infobox-value">{settingsCount} reviewed</div>
    </div>
    <div class="infobox-row">
      <div class="infobox-label">Severity</div>
      <div class="infobox-value">
        <span class={`sev-dot sev-dot--${severity}`}></span>{severity.charAt(0).toUpperCase() + severity.slice(1)}
      </div>
    </div>
    <div class="infobox-row">
      <div class="infobox-label">Verified</div>
      <div class="infobox-value">
        <span class="verified-check">&#10003;&ensp;</span><span class="verified-date">{lastVerified}</span>
      </div>
    </div>
    {relatedPractices.length > 0 && (
      <div class="infobox-row infobox-row--column">
        <div class="infobox-label infobox-label--full">Data Practices</div>
        <div class="infobox-practices">
          {relatedPractices.map(p => (
            <a href={p.href}>{p.label}</a>
          ))}
        </div>
      </div>
    )}
  </div>
</div>

<style>
  .infobox {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    width: 100%;
  }

  .infobox-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.75rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-raised);
  }

  .infobox-platform-name {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .infobox-rows {}

  .infobox-row {
    display: flex;
    border-bottom: 1px solid var(--color-border-subtle, var(--color-border));
    font-size: 0.8125rem;
  }

  .infobox-row:last-child {
    border-bottom: none;
  }

  .infobox-row--column {
    flex-direction: column;
  }

  .infobox-label {
    width: 110px;
    flex-shrink: 0;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: rgba(17, 17, 17, 0.5);
    border-right: 1px solid var(--color-border);
    display: flex;
    align-items: center;
  }

  .infobox-label--full {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid var(--color-border);
  }

  .infobox-value {
    padding: 0.5rem 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.5;
    flex: 1;
    min-width: 0;
  }

  .infobox-sub {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .sev-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-right: 0.375rem;
    position: relative;
    top: -1px;
  }

  .sev-dot--critical { background: var(--color-critical); }
  .sev-dot--high { background: var(--color-high); }
  .sev-dot--medium { background: var(--color-medium); }

  .verified-check {
    color: var(--color-text-muted);
  }

  .verified-date {
    color: var(--color-text-secondary);
  }

  .infobox-practices {
    padding: 0.625rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .infobox-practices a {
    font-size: 0.75rem;
    color: var(--color-accent-blue);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .infobox-practices a:hover {
    text-decoration: underline;
  }

  .infobox-practices a::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-critical);
    flex-shrink: 0;
  }
</style>
